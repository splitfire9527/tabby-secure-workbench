{
  "name": "tabby-secure-workbench",
  "version": "1.0.0",
  "description": "Professional SSH Workbench plugin for Tabby featuring unified workbench shell, command library, dual-pane SFTP+ transfer with cross-connection copy, stateful multi-byte codec, and verified session logging.",
